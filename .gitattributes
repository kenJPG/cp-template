# Neovim config: LF everywhere. Windows Neovim reads LF fine, and LF avoids
# any tooling that chokes on CRLF in Lua.
*.lua           text eol=lf

# Windows scripts: force CRLF. PowerShell tolerates LF, but cmd.exe can
# genuinely misparse batch files with LF-only endings (labels/GOTO edge
# cases), so don't leave .cmd endings to each machine's autocrlf setting.
*.ps1           text eol=crlf
*.cmd           text eol=crlf

# Docs: LF is fine everywhere.
*.md            text eol=lf
