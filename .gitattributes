# These files run inside WSL/Linux — they MUST keep LF line endings.
# CRLF in a shell script produces `bad interpreter: /usr/bin/env bash^M`.
*.sh            text eol=lf
# Neovim/LazyVim config is loaded by a Linux Neovim; keep LF to be safe.
*.lua           text eol=lf

# Windows-side scripts are fine either way; leave them CRLF on Windows.
*.ps1           text eol=crlf

# Docs: let git normalize; LF is fine everywhere.
*.md            text eol=lf
